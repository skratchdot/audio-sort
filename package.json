{
  "name": "audio-sort",
  "version": "0.2.0",
  "description": "Listen to sorting algorithms",
  "keywords": [
    "algorithms",
    "audio",
    "sort",
    "sorting"
  ],
  "homepage": "https://github.com/skratchdot/audio-sort",
  "bugs": {
    "url": "https://github.com/skratchdot/audio-sort/issues"
  },
  "author": "skratchdot",
  "repository": {
    "type": "git",
    "url": "git://github.com/skratchdot/audio-sort.git"
  },
  "scripts": {
    "build": "pnpm run clean && eleventy",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "serve": "pnpm run clean && eleventy --serve",
    "start": "pnpm run serve",
    "preview": "vite preview --outDir dist",
    "test:browser": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run lint && pnpm run format:check && pnpm test && pnpm run build",
    "watch": "pnpm run serve"
  },
  "dependencies": {
    "ace-builds": "1.44.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-vite": "^8.0.0",
    "@playwright/test": "^1.63.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/skratchdot/audio-sort/blob/master/LICENSE-MIT"
    }
  ]
}
