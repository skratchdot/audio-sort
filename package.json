{
	"name": "audio-sort",
	"description": "Listen to sorting algorithms",
	"version": "0.2.0",
	"homepage": "https://github.com/skratchdot/audio-sort",
	"author": "skratchdot",
	"repository": {
		"type": "git",
		"url": "git://github.com/skratchdot/audio-sort.git"
	},
	"bugs": {
		"url": "https://github.com/skratchdot/audio-sort/issues"
	},
	"licenses": [
		{
			"type": "MIT",
			"url": "https://github.com/skratchdot/audio-sort/blob/master/LICENSE-MIT"
		}
	],
	"engines": {
		"node": ">=24"
	},
	"packageManager": "npm@11.19.0",
	"scripts": {
		"build": "npm run build:assets && npm run build:site",
		"build:assets": "grunt build",
		"build:site": "npm run clean && eleventy",
		"clean": "node -e \"require('node:fs').rmSync('_site', { recursive: true, force: true })\"",
		"serve": "npm run clean && eleventy --serve",
		"start": "npm run build:assets && npm run serve",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"lint": "oxlint --deny-warnings",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"check": "npm run lint && npm run fmt:check && npm test && npm run build",
		"watch": "grunt watch"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.6",
		"grunt": "^1.5.3",
		"grunt-contrib-concat": "^2.1.0",
		"grunt-contrib-cssmin": "^4.0.0",
		"grunt-contrib-uglify": "^5.2.2",
		"grunt-contrib-watch": "^1.1.0",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"vitest": "^5.0.0"
	},
	"keywords": [
		"audio",
		"sort",
		"sorting",
		"algorithms"
	]
}
